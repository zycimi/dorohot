# 网站名称
NEXT_PUBLIC_APP_NAME = 'doroHot'
# 网站描述
NEXT_PUBLIC_APP_DESC = '汇聚全网热点资讯，实时掌握热门趋势'
# 网站地址
NEXT_PUBLIC_APP_URL = 'http://localhost:3000'
# 仓库地址（头部 Github 按钮；本项目 fork 自上游，默认指向上游仓库）
NEXT_PUBLIC_REPO_URL = 'https://github.com/baiwumm/next-daily-hot'
# 版权名称
NEXT_PUBLIC_COPYRIGHT = 'doroHot'
# ICP 备案号
NEXT_PUBLIC_ICP = ''
# 公安备案号
NEXT_PUBLIC_GONGAN = ''
# 百度 ID
NEXT_PUBLIC_BAIDU_ID = ''
# Google ID
NEXT_PUBLIC_GOOGLE_ID = ''
# Clarity ID
NEXT_PUBLIC_CLARITY_ID = ''

# ============================================================
# 认证（可选，2026-10-01 新增）
# ============================================================
# 会话签名密钥：不设置时自动生成并保存在 data/auth.json（已被 gitignore / 打包器排除）
# DOROHOT_AUTH_SECRET = ''
# HTTPS 部署时设为 1，给会话 Cookie 加 Secure（局域网 http 部署请保持 0/不设）
# DOROHOT_AUTH_SECURE = '0'
# 认证数据文件位置（默认 data/auth.json）
# DOROHOT_AUTH_FILE = ''
# MCP 令牌/配置数据文件位置（默认 data/mcp.json）
# DOROHOT_MCP_FILE = ''
# 远程接入渠道数据文件位置（默认 data/channels.json）
# DOROHOT_CHANNELS_FILE = ''